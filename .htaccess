# ==============================================================================
# Apache Configuration (.htaccess) for Joule Asset Valuers (https://jouleassetvaluers.com)
# Enforces Single Canonical Version: HTTPS Non-WWW (301 Permanent Redirect)
# High-Performance Speed: Gzip Deflate Compression + 1-Year Static Media Caching
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 301 Permanent Redirect: index.html to canonical root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.html\ HTTP/ [NC]
    RewriteRule ^index\.html$ https://jouleassetvaluers.com/ [R=301,L]

    # 301 Permanent Redirect: privacy.html to privacy-policy.html
    RewriteRule ^privacy\.html$ /privacy-policy.html [L,R=301]

    # 1. Force HTTPS and redirect www to non-www in a single 301 redirect
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.jouleassetvaluers\.com$ [NC]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://jouleassetvaluers.com%{REQUEST_URI} [L,R=301,NE]

    # Also handle legacy joulevaluers.com domain redirects if traffic arrives from it
    RewriteCond %{HTTP_HOST} ^(?:www\.)?joulevaluers\.com$ [NC]
    RewriteRule ^ https://jouleassetvaluers.com%{REQUEST_URI} [L,R=301,NE]

    # Generic fallback
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301,NE]
</IfModule>

# ==============================================================================
# GZIP / BROTLI COMPRESSION (MOD_DEFLATE)
# Compresses text assets by 70% to 80% to maximize Google PageSpeed & FCP/LCP
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/eot
</IfModule>

# ==============================================================================
# BROWSER CACHING (MOD_EXPIRES & CACHE-CONTROL)
# Caches static images, videos, fonts, CSS and JS for 1 year
# HTML and XML documents revalidate for instantaneous search engine freshness
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Images & Media (1 Year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Web Fonts (1 Year)
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Stylesheets & Scripts (1 Year - versioned with ?v= query strings)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # HTML Documents & Feeds (Revalidate immediately)
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
    ExpiresByType text/xml "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ==============================================================================
# Cache-Control & Version Management
# ==============================================================================
<IfModule mod_headers.c>
    # Static Assets: 1 Year Cache
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|svg|ico|mp4|webm|woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # Versioned CSS & JS: 1 Year Cache with Public Revalidation
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # HTML, XML, JSON: Always Fresh for Users and Crawlers
    <FilesMatch "\.(html|htm|xml|txt|json)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>
</IfModule>

# ==============================================================================
# HTTP Strict Transport Security (HSTS)
# ==============================================================================
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ==============================================================================
# Custom 404 Error Document (Directly routes wrongly opened URLs to custom 404)
# ==============================================================================
ErrorDocument 404 /404.html

RewriteRule ^terms-conditions\.html$ /terms.html [L,R=301]
